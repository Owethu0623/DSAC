# All values below are OPTIONAL. Anything prefixed VITE_ is compiled into the browser bundle and is therefore PUBLIC:
# never put a secret in a VITE_ variable.

# Demonstration mode (default: on). Seeds the demo organisations and shows the one-click demo sign-in buttons.
# Set to "false" for any real deployment.
VITE_DEMO_MODE=true

# Shared, non-secret password for the demo accounts (only used when demo mode is on).
# VITE_DEMO_PASSWORD=Demo@2026!

# Reporting period the platform is "as at", written "<financial year>:<quarter>". Default: 2025/26:Q3.
# For the real clock, derive it from the date (see src/services/reportingPeriod.ts) or set it here.
# VITE_REPORTING_PERIOD=2026/27:Q1

# Reserved for future server-side AI. The Gemini SDK is installed but not called by this build, and a key placed in a
# client bundle would be exposed to every visitor. Call the model from a server function, never from the browser.
GEMINI_API_KEY=
